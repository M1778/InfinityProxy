# Engine
INFINITY_HOST=127.0.0.1
INFINITY_PORT=8787
INFINITY_PANEL_HOST=127.0.0.1
INFINITY_PANEL_PORT=8000
INFINITY_ENGINE_URL=http://127.0.0.1:8787
INFINITY_PANEL_BASE_URL=http://127.0.0.1:8000
INFINITY_TUNNEL_RANGE=10000-59999
INFINITY_BATCH_SIZE=50
INFINITY_PROBE_TIMEOUT_MS=4000
INFINITY_PROBE_BUDGET_PER_REFRESH=5000
INFINITY_HEALTH_INTERVAL_S=30
INFINITY_URTEST_INTERVAL_S=30
INFINITY_MAX_MISSES=2
INFINITY_DB=infinity.db
INFINITY_SINGBOX_IMAGE=ghcr.io/sagernet/sing-box:v1.11.6
INFINITY_ENGINE_NAME_PREFIX=infinity

# Admission throughput gate: docs/api.md#configuration, ADR-0008, ADR-0011
INFINITY_THROUGHPUT_ENABLED=1
INFINITY_THROUGHPUT_MIN_KB_S=200
INFINITY_THROUGHPUT_SAMPLE_BYTES=1048576
INFINITY_THROUGHPUT_TIMEOUT_S=12.0
INFINITY_THROUGHPUT_HOST=speed.cloudflare.com
INFINITY_THROUGHPUT_PORT=80
INFINITY_THROUGHPUT_PATH="/__down?bytes=10485760"

# Stability-scored assignment (ADR-0009)
INFINITY_STABILITY_ENABLED=1
INFINITY_STABILITY_MIN_PROBES=6
INFINITY_STABILITY_MIN_AVAIL=0.4
INFINITY_STABILITY_WEIGHT_AVAIL=0.6
INFINITY_STABILITY_WEIGHT_SPEED=0.4
INFINITY_STABILITY_WINDOW_S=3600
INFINITY_STABILITY_MAX_AGE_S=21600
INFINITY_STABILITY_WORKING_SET=256
INFINITY_STABILITY_WORKING_SET_CADENCE_S=300
INFINITY_STABILITY_REPROBE_MIN_S=120

# Panel
INFINITY_PANEL_TEST_URL=https://api.ipify.org

# Host features (system proxy + TUN) via a privileged hostagent: docs/api.md#host
INFINITY_HOST_ENABLED=0
INFINITY_HOSTAGENT_URL=http://127.0.0.1:8788
INFINITY_HOSTAGENT_PORT=8788
INFINITY_HOST_UID=1000
INFINITY_HOST_BUS=/run/user/1000/bus
INFINITY_HOST_PICK_TTL_S=60
INFINITY_HOST_PICK_TEST_URL=https://api.ipify.org
INFINITY_HOST_PICK_SAMPLE_BYTES=262144
INFINITY_HOST_PICK_TIMEOUT_S=8.0
